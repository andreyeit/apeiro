{
  "name": "apeiro-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "build": "pnpm -r build",
    "bench:scene": "vitest bench --run packages/core/src/scene/scene.bench.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --max-warnings 0 .",
    "lint:fix": "oxlint --max-warnings 0 --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "dev": "pnpm --filter @apeiro/playground dev"
  },
  "devDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}

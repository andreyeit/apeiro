{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // The workspace packages are bundled: resolve them to their sources (not through
    // node_modules), so their declarations are emitted and bundled too.
    "paths": {
      "@apeiro/core": ["../core/src/index.ts"],
      "@apeiro/renderer": ["../renderer/src/index.ts"],
      "@apeiro/editor": ["../editor/src/index.ts"],
      "@apeiro/react": ["../react/src/index.ts"]
    }
  },
  "include": ["src"]
}
